DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:2003/civiclens
SECRET_KEY=change-this-to-a-long-random-secret
FLASK_DEBUG=1
SEED_DEMO_DATA=true
PORT=5000
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=180

# Local AI (no RAG)
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b

# Fast local AI (no RAG)
AI_FAST_MODEL=qwen3:0.6b
AI_TIMEOUT_SECONDS=25

# Evidence limits
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
MAX_DOCUMENT_MB=20
MAX_VIDEO_SECONDS=60
MAX_IMAGES_PER_COMPLAINT=5
MAX_VIDEOS_PER_COMPLAINT=1
MAX_FILES_PER_COMPLAINT=6

# Citizen OTP verification
OTP_PROVIDER=2factor
OTP_API_KEY=
OTP_COUNTRY_CODE=91
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Email SMTP (Gmail: smtp.gmail.com / 587 with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Development only: if true, OTP is returned on-screen instead of requiring providers
DEV_OTP=false
