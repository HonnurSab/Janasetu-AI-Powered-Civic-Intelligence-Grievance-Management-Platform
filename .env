DATABASE_URL=postgresql://postgres:civiclens123@localhost:2003/civiclens
SECRET_KEY=replace-this-with-a-long-random-secret
FLASK_DEBUG=1
SEED_DEMO_DATA=true
PORT=5000

SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=180

# =========================
# LOCAL AI
# =========================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
AI_TIMEOUT_SECONDS=120

# Fast local AI (no RAG)
AI_FAST_MODEL=qwen3:0.6b
AI_TIMEOUT_SECONDS=25

# Evidence limits
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
MAX_DOCUMENT_MB=20
MAX_VIDEO_SECONDS=60
MAX_IMAGES_PER_COMPLAINT=5
MAX_VIDEOS_PER_COMPLAINT=1
MAX_FILES_PER_COMPLAINT=6


# =========================
# OTP / ACCOUNT VERIFICATION
# =========================
OTP_PROVIDER=2factor
OTP_API_MODE=v4
OTP_API_URL=https://2factor.in/API/V1/OTP/SEND
OTP_API_KEY=
OTP_TEMPLATE_NAME=LOGIN_OTP
OTP_COUNTRY_CODE=91
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Email OTP via SMTP (Gmail requires an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Local demo fallback. When true, no external OTP provider is contacted.
DEV_OTP=true

# Allows citizens to register without OTP. Set false for strict production verification.
ALLOW_UNVERIFIED_REGISTRATION=true
